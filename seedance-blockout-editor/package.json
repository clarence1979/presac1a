{
  "name": "seedance-3d-blockout-editor",
  "version": "0.1.0",
  "description": "Blockout camera editor: direct a 30-second three.js take (pill method) and use it as the camera reference for Seedance 2.5. Built on the Tein API.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node serve.mjs",
    "start:send": "node serve.mjs",
    "bridge": "node bridge.mjs",
    "stills": "node render.mjs stills out/stills 0 5 10 15 20 25 29.5",
    "render": "node render.mjs video out/blockout.mp4 24",
    "test": "node tools/previs/check-sheet.mjs projects/midnight-courier-2",
    "check:street-pov": "node check.mjs",
    "check": "node tools/previs/check-sheet.mjs projects/midnight-courier-2",
    "test:editor": "node tools/tests/editor-save.mjs",
    "test:web": "node tools/tests/web-generate.mjs",
    "test:replicate": "node tools/tests/replicate.mjs",
    "test:studio": "node tools/tests/studio.mjs",
    "stamp": "node tools/stamp.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^23.0.0"
  }
}
